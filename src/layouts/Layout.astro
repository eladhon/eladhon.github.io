---
interface Props {
	title: string;
	description?: string;
	blogTitle?: string;
}

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Modals from "../components/Modals.astro";
import "../styles/global.css";

const { title, description = "Software Engineer Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet" />
		<title>{title}</title>

		<!-- Prevent FOUC: apply theme before page renders -->
		<script is:inline>
			(function() {
				var cl = document.documentElement.classList;
				cl.add('no-transitions');
				if (
					localStorage.getItem("color-theme") === "dark" ||
					(!("color-theme" in localStorage) &&
						window.matchMedia("(prefers-color-scheme: dark)").matches)
				) {
					cl.add("dark");
				} else {
					cl.remove("dark");
				}
				// Re-enable transitions after a tick
				requestAnimationFrame(function() {
					requestAnimationFrame(function() {
						cl.remove('no-transitions');
					});
				});
			})();
		</script>
	</head>
	<body class="relative min-h-screen bg-[#fafafa] dark:bg-[#000000] text-zinc-900 dark:text-[#ededed] font-sans antialiased grid-bg selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black overflow-x-hidden">
		<!-- Interactive Cursor Spotlight Glow -->
		<div id="glow-background" class="glow-effect" aria-hidden="true"></div>

		<!-- Top Navbar -->
		<Navbar />

		<!-- Main Content Sections -->
		<main class="relative z-10 flex min-h-[calc(100vh-56px)] w-full flex-col items-center pt-14">
			<slot />
		</main>

		<!-- Footer -->
		<Footer />

		<!-- Modals & Toasts -->
		<Modals />

		<script>
			// Glow effect logic
			document.addEventListener("mousemove", (e) => {
				const glow = document.getElementById("glow-background");
				if (glow) {
					glow.style.left = `${e.clientX}px`;
					glow.style.top = `${e.clientY}px`;
				}
			});
		</script>
	</body>
</html>
