---
import { PERSONAL_INFO } from "../data/portfolioData";
import profileImg from "../assets/profile.jpeg";
import { getCollection } from "astro:content";

const posts = await getCollection("my-blog", ({ data }) => !data.draft);
const latestPost = [...posts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];

const DAYS_THRESHOLD = 14;
const isRecentPost = latestPost?.data?.date
  ? Date.now() - new Date(latestPost.data.date).getTime() <
    DAYS_THRESHOLD * 24 * 60 * 60 * 1000
  : false;

const availabilityItems = [
  ...(PERSONAL_INFO.availability.forHire
    ? [
        {
          label: "Available for hire",
          text: "Open to software engineering opportunities",
          href: PERSONAL_INFO.linkedin,
          external: true,
        },
      ]
    : []),
  ...(PERSONAL_INFO.availability.forFreelance
    ? [
        {
          label: "Available for freelance",
          text: "Open to freelance software projects",
          href: PERSONAL_INFO.linkedin,
          external: true,
        },
      ]
    : []),
];

const statusItems = [
  ...availabilityItems,
  ...(PERSONAL_INFO.status.enabled
    ? [
        {
          label: PERSONAL_INFO.status.label || "Status",
          text: PERSONAL_INFO.status.message,
        },
      ]
    : []),
  ...(isRecentPost && latestPost
    ? [
        {
          label: "New blog",
          text: latestPost.data.title,
          href: `/blog/${latestPost.id.replace(/\.[^/.]+$/, "")}`,
          external: false,
        },
      ]
    : []),
];
---

<div id="hero-container" class="w-full flex flex-col items-center">
  <div
    class="mt-10 sm:mt-16 mb-10 sm:mb-16 w-full max-w-5xl mx-auto px-4"
  >
    <ul class="flex flex-wrap justify-center gap-2 sm:gap-3" aria-label="Current status">
      {
        statusItems.map((item) => (
          <li>
            {item.href ? (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="inline-flex max-w-full items-center gap-2 border border-black/15 bg-white px-3 py-1.5 text-xs text-zinc-600 shadow-sm transition-all hover:border-black/35 hover:bg-gray-50 dark:border-white/15 dark:bg-[#0a0a0a] dark:text-zinc-300 dark:hover:border-white/35 dark:hover:bg-[#121212] sm:gap-3 sm:px-4 sm:text-sm"
              >
                <span class="h-1.5 w-1.5 shrink-0 bg-black dark:bg-white"></span>
                <span class="whitespace-nowrap font-medium text-black dark:text-white">{item.label}</span>
                <span class="truncate text-zinc-500 dark:text-zinc-400">{item.text}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            ) : (
              <div class="inline-flex max-w-full items-center gap-2 border border-black/15 bg-white px-3 py-1.5 text-xs text-zinc-600 shadow-sm dark:border-white/15 dark:bg-[#0a0a0a] dark:text-zinc-300 sm:gap-3 sm:px-4 sm:text-sm">
                <span class="h-1.5 w-1.5 shrink-0 bg-black dark:bg-white"></span>
                <span class="whitespace-nowrap font-medium text-black dark:text-white">{item.label}</span>
                <span class="truncate text-zinc-500 dark:text-zinc-400">{item.text}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="w-full max-w-5xl mx-auto mb-20 sm:mb-32 flex flex-col md:flex-row items-center md:items-stretch text-center md:text-left justify-between px-4 sm:px-6 gap-8 md:gap-12"
  >
    <div
      class="w-full md:w-[55%] flex flex-col items-center md:items-start justify-center order-2 md:order-1"
    >
      <h1
        id="hero-title"
        class="text-4xl sm:text-6xl md:text-7xl text-black dark:text-white mb-3 tracking-tight font-bold leading-[1.1]"
      >
        Hi, I'm <br />
        <span
          class="text-black dark:text-white drop-shadow-sm dark:drop-shadow-[0_0_35px_rgba(255,255,255,0.25)] flex flex-wrap gap-2 justify-center md:justify-start mt-2"
        >
          <span class="relative group pronounce-wrapper cursor-pointer">
            <span
              id="eldho-text"
              class="inline-block hover:-translate-y-1 transition-transform"
              >Eldho</span
            >
            <button
              id="pronounce-eldho"
              class="pronounce-btn absolute left-1/2 -translate-x-1/2 -top-10 px-3 py-1.5 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 text-sm font-medium text-black dark:text-white flex items-center gap-1.5 shadow-lg whitespace-nowrap rounded-sm z-50"
            >
              /EL-dho/ <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3.5 h-3.5"
                ><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"
                ></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path
                  d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg
              >
            </button>
          </span>
          <span class="relative group pronounce-wrapper cursor-pointer">
            <span
              id="eapen-text"
              class="inline-block hover:-translate-y-1 transition-transform"
              >Eapen</span
            >
            <button
              id="pronounce-eapen"
              class="pronounce-btn absolute left-1/2 -translate-x-1/2 -top-10 px-3 py-1.5 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 text-sm font-medium text-black dark:text-white flex items-center gap-1.5 shadow-lg whitespace-nowrap rounded-sm z-50"
            >
              /EE-pen/ <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3.5 h-3.5"
                ><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"
                ></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path
                  d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg
              >
            </button>
          </span>
        </span>
      </h1>

      <h2
        id="hero-subtitle"
        class="text-lg sm:text-2xl md:text-3xl text-zinc-600 dark:text-zinc-300 mb-6 font-medium tracking-tight flex flex-wrap justify-center md:justify-start gap-1.5 items-end"
      >
        <span>and I'm a</span>
        <span
          class="inline-block h-[1.2em] overflow-hidden align-bottom border-b border-black/30 dark:border-white/30 pb-0.5"
        >
          <span class="animate-text-slide inline-block">
            <span class="block h-[1.2em] text-black dark:text-white"
              >Software Engineer</span
            >
            <span class="block h-[1.2em] text-black dark:text-white"
              >Graphic Designer</span
            >
            <span class="block h-[1.2em] text-black dark:text-white"
              >Software Engineer</span
            >
          </span>
        </span>
      </h2>

      <p
        id="hero-bio"
        class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mb-8 sm:mb-10 max-w-lg leading-relaxed font-normal"
      >
        {PERSONAL_INFO.bio}
      </p>

      <div
        class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 mb-8 w-full sm:w-auto"
      >
        <a
          id="view-resume-btn"
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3 bg-black dark:bg-white hover:bg-zinc-800 dark:hover:bg-zinc-200 active:bg-zinc-700 dark:active:bg-zinc-300 text-white dark:text-black font-semibold flex items-center justify-center gap-2 transition-all shadow-[0_0_30px_rgba(0,0,0,0.15)] dark:shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:shadow-[0_0_40px_rgba(0,0,0,0.25)] dark:hover:shadow-[0_0_40px_rgba(255,255,255,0.35)] text-sm sm:text-base group border border-black dark:border-white"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 transition-transform group-hover:scale-110"
            ><path
              d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
            ></path><polyline points="14 2 14 8 20 8"></polyline><line
              x1="16"
              y1="13"
              x2="8"
              y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line
              x1="10"
              y1="9"
              x2="8"
              y2="9"></line></svg
          >
          <span>View My Resume</span>
        </a>

        <a
          id="view-projects-btn"
          href="#projects"
          class="w-full sm:w-auto px-6 py-3 bg-white dark:bg-[#0a0a0a] border border-black/20 dark:border-white/20 hover:border-black/45 dark:hover:border-white/45 hover:bg-gray-50 dark:hover:bg-[#141414] text-black dark:text-white font-medium flex items-center justify-center gap-2 transition-all text-sm sm:text-base group"
        >
          <span>View Projects</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-hover:text-black dark:group-hover:text-white group-hover:translate-x-1 transition-all"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
      </div>

      <div
        id="hero-socials"
        class="flex flex-wrap items-center justify-center md:justify-start gap-2 sm:gap-3"
      >
        <a
          href={PERSONAL_INFO.github}
          target="_blank"
          rel="noopener noreferrer"
          title="GitHub Profile"
          class="w-10 h-10 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 hover:border-black/40 dark:hover:border-white/40 hover:bg-gray-50 dark:hover:bg-[#161616] flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-all transform hover:-translate-y-0.5"
        >
          <svg
            class="w-5 h-5 fill-current"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </a>

        <a
          href={PERSONAL_INFO.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          title="LinkedIn Profile"
          class="w-10 h-10 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 hover:border-black/40 dark:hover:border-white/40 hover:bg-gray-50 dark:hover:bg-[#161616] flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-all transform hover:-translate-y-0.5"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            ><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path
              d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg
          >
        </a>

        <a
          href={PERSONAL_INFO.instagram}
          target="_blank"
          rel="noopener noreferrer"
          title="Instagram Profile"
          class="w-10 h-10 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 hover:border-black/40 dark:hover:border-white/40 hover:bg-gray-50 dark:hover:bg-[#161616] flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-all transform hover:-translate-y-0.5"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path
              d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line
              x1="17.5"
              y1="6.5"
              x2="17.51"
              y2="6.5"></line></svg
          >
        </a>

        <a
          href={PERSONAL_INFO.threads}
          target="_blank"
          rel="noopener noreferrer"
          title="Threads Profile"
          class="w-10 h-10 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 hover:border-black/40 dark:hover:border-white/40 hover:bg-gray-50 dark:hover:bg-[#161616] flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-all transform hover:-translate-y-0.5"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path></svg
          >
        </a>

        <a
          href={PERSONAL_INFO.twitter}
          target="_blank"
          rel="noopener noreferrer"
          title="X / Twitter"
          class="w-10 h-10 bg-white dark:bg-[#0a0a0a] border border-black/15 dark:border-white/15 hover:border-black/40 dark:hover:border-white/40 hover:bg-gray-50 dark:hover:bg-[#161616] flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-all transform hover:-translate-y-0.5"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line></svg
          >
        </a>
      </div>
    </div>

    <div
      class="w-full md:w-[45%] relative flex justify-center md:justify-end order-1 md:order-2 h-auto"
    >
      <div
        id="hero-portrait-frame"
        class="relative w-[240px] xs:w-[280px] sm:w-[340px] md:w-full max-w-[480px] h-[300px] xs:h-[360px] sm:h-[430px] md:h-full md:min-h-[500px] bg-white dark:bg-[#0a0a0a] overflow-hidden border border-black/15 dark:border-white/15 shadow-[0_0_50px_rgba(0,0,0,0.1)] dark:shadow-[0_0_50px_rgba(0,0,0,0.9)] transition-transform hover:scale-[1.01]"
      >
        <img
          id="hero-portrait-img"
          src={profileImg.src}
          alt={`${PERSONAL_INFO.name} - Software Engineer`}
          class="w-full h-full object-cover object-top opacity-95 transition-opacity duration-300"
          loading="eager"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-white/70 dark:from-[#000000]/70 via-transparent to-transparent pointer-events-none"
        >
        </div>
      </div>

      <div
        class="absolute inset-0 bg-black/[0.05] dark:bg-white/[0.03] blur-[90px] -z-10 pointer-events-none transform scale-90"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</div>

<script>
  const playAudio = (file: string) => {
    const audio = new Audio(file);
    audio.play().catch((err) => {
      console.warn("Pronunciation audio missing:", err);
    });
  };

  const eldhoText = document.getElementById("eldho-text");
  const eldhoBtn = document.getElementById("pronounce-eldho");
  const eapenText = document.getElementById("eapen-text");
  const eapenBtn = document.getElementById("pronounce-eapen");

  const handleTap = (
    btn: HTMLElement | null,
    otherBtn: HTMLElement | null,
    file: string,
    e: Event,
  ) => {
    e.stopPropagation();
    if (!btn) return;

    const isVisible = btn.classList.contains("mobile-visible");
    otherBtn?.classList.remove("mobile-visible");

    if (isVisible) {
      btn.classList.remove("mobile-visible");
      playAudio(file);
    } else {
      btn.classList.add("mobile-visible");
    }
  };

  eldhoText?.addEventListener("click", (e) =>
    handleTap(eldhoBtn, eapenBtn, "/eldho.mp3", e),
  );
  eapenText?.addEventListener("click", (e) =>
    handleTap(eapenBtn, eldhoBtn, "/eapen.mp3", e),
  );

  eldhoBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    playAudio("/eldho.mp3");
  });

  eapenBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    playAudio("/eapen.mp3");
  });

  document.addEventListener("click", () => {
    eldhoBtn?.classList.remove("mobile-visible");
    eapenBtn?.classList.remove("mobile-visible");
  });

</script>
