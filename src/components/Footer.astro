---

---

<footer
    class="mt-32 pt-12 pb-8 border-t border-gray-200 dark:border-dark-border"
>
    <div class="flex flex-col items-center gap-4 text-center">
        <!-- Made with Love -->
        <div
            class="flex items-center gap-2 text-gray-600 dark:text-gray-400 font-medium"
        >
            <span>Made with</span>
            <i class="fa-solid fa-heart text-red-500 animate-pulse"></i>
            <span>by Eldho Eapen</span>
        </div>

        <!-- Links -->
        <div class="flex items-center gap-6 text-sm">
            <a
                href="https://github.com/eladhon/eladhon.github.io/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors duration-200"
            >
                <i class="fa-brands fa-github text-lg"></i>
                <span>Source Code</span>
            </a>
            <span class="text-gray-300 dark:text-gray-700">|</span>
            <a
                href="/rss.xml"
                class="flex items-center gap-2 text-gray-500 hover:text-orange-600 dark:text-gray-400 dark:hover:text-orange-400 transition-colors duration-200"
            >
                <i class="fa-solid fa-rss text-lg"></i>
                <span>RSS Feed</span>
            </a>
        </div>

        <!-- Copyright -->
        <p class="text-gray-400 dark:text-gray-600 text-xs mt-4">
            &copy; {new Date().getFullYear()} Eldho Eapen. Built with Astro & TailwindCSS.
        </p>
    </div>
</footer>
