---
import type { ProjectItem } from "../types";

interface Props {
  project: ProjectItem;
  interactive?: boolean;
}

const { project, interactive = false } = Astro.props; 
---

<article
  id={interactive ? `project-card-${project.id}` : undefined}
  class="project-card group relative flex flex-col overflow-hidden border border-black/10 bg-white transition-all dark:border-white/10 dark:bg-[#0a0a0a] hover:border-black/30 dark:hover:border-white/30"
  data-id={interactive ? project.id : undefined}
  role={interactive ? "button" : undefined}
  tabindex={interactive ? "0" : undefined}
  aria-haspopup={interactive ? "dialog" : undefined}
  aria-controls={interactive ? `project-modal-${project.id}` : undefined}
  aria-label={interactive ? `View details for ${project.title}` : undefined}
>
  <header class="flex h-10 shrink-0 items-center justify-between border-b border-black/10 bg-gray-50 px-4 dark:border-white/10 dark:bg-[#050505]">
    <div class="flex items-center gap-2 font-mono text-xs text-zinc-700 dark:text-zinc-300">
      {
        project.fileIcon === "terminal" ? (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-zinc-600 dark:text-zinc-300" aria-hidden="true"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-zinc-600 dark:text-zinc-400" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        )
      }
      <span class="transition-colors group-hover:text-black dark:group-hover:text-white">{project.filename}</span>
    </div>

    {
      interactive ? (
        <span class="flex items-center gap-1 font-mono text-[11px] text-zinc-500 transition-colors group-hover:text-black dark:group-hover:text-white">
          <span>View details</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </span>
      ) : (
        <div class="relative z-10 flex items-center gap-3">
          {
            project.githubUrl && (
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 transition-colors hover:text-black dark:hover:text-white" title={`View ${project.title} source`} aria-label={`View ${project.title} source`}>
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .269.18.579.688.481C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path></svg>
              </a>
            )
          }
          {
            project.liveUrl && project.liveUrl !== project.githubUrl && (
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 transition-colors hover:text-black dark:hover:text-white" title={`View ${project.title} demo`} aria-label={`View ${project.title} demo`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            )
          }
        </div>
      )
    }
  </header>

  <div class={`flex flex-1 flex-col p-6 ${interactive ? "pointer-events-none justify-between" : ""}`}>
    <div class="flex-1">
      <h3 class="mb-2 text-lg font-semibold leading-snug text-black transition-colors group-hover:text-neutral-800 dark:text-white dark:group-hover:text-neutral-200 sm:text-xl">
        {project.title}
      </h3>
      <p class="mb-3 text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-sm">
        {project.description}
      </p>
      {
        !interactive && (
          <p class="mb-6 text-xs leading-relaxed text-zinc-500 dark:text-zinc-500">
            {project.fullDetails}
          </p>
        )
      }
    </div>

    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      {project.tags.map((tag) => (
        <span class="border border-black/10 bg-gray-50 px-2.5 py-1 font-mono text-xs text-zinc-700 transition-colors group-hover:border-black/25 dark:border-white/10 dark:bg-[#050505] dark:text-zinc-300 dark:group-hover:border-white/25">
          {tag}
        </span>
      ))}
    </div>
  </div>
</article>
