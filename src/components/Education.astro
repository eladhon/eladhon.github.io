---
import { EDUCATION_DATA } from '../data/portfolioData';

const getEduIcon = (index: number) => {
  if (index === 0) {
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-300"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>`;
  }
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-zinc-600 dark:text-zinc-400"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>`;
};
---

<section id="education" class="w-full max-w-5xl mx-auto mb-24 sm:mb-32 pt-8 px-4 sm:px-6">
  <!-- Section Header -->
  <div class="border-b border-black/10 dark:border-white/10 pb-4 mb-8 flex justify-between items-end">
    <h3 class="text-2xl sm:text-3xl text-black dark:text-white font-semibold tracking-tight">
      Education
    </h3>
    <span class="font-mono text-xs sm:text-sm text-zinc-500 font-medium">/02</span>
  </div>

  <!-- Education Timeline Cards - Sharp Monochrome -->
  <div class="space-y-6">
    {EDUCATION_DATA.map((edu, idx) => (
      <article
        id={`education-card-${edu.id}`}
        class="edu-card flex flex-col md:flex-row bg-white dark:bg-[#0a0a0a] border border-black/10 dark:border-white/10 hover:border-black/30 dark:hover:border-white/30 transition-all group relative overflow-hidden interactive-card p-6 gap-6 cursor-pointer"
        data-id={edu.id}
      >
        <!-- Left meta (Period & Domain link) -->
        <div class="md:w-1/4 flex flex-row md:flex-col justify-start items-center md:items-start gap-3 md:gap-0 shrink-0 pb-3 md:pb-0 border-b md:border-b-0 border-black/10 dark:border-white/10">
          <span class="font-mono text-xs font-semibold text-black dark:text-white">
            {edu.period}
          </span>
          <span class="text-black/20 dark:text-white/20 md:hidden">·</span>
          <span class="font-mono text-xs text-zinc-600 dark:text-zinc-400 md:mt-1 flex items-center gap-1.5 hover:text-black dark:hover:text-white transition-colors">
            <span set:html={getEduIcon(idx)} />
            <span>{edu.domain}</span>
          </span>
        </div>

        <!-- Right content -->
        <div class="md:w-3/4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <h4 class="text-lg sm:text-xl text-black dark:text-white font-semibold mb-1 group-hover:text-neutral-800 dark:group-hover:text-neutral-200 transition-colors">
                {edu.degree}
              </h4>
              <button
                aria-label="Toggle details"
                class="p-1 text-zinc-500 group-hover:text-black dark:group-hover:text-white transition-colors cursor-pointer"
              >
                <!-- Down Chevron (Default) -->
                <svg class="chevron-down w-4 h-4 opacity-50 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                <!-- Up Chevron (Hidden by default) -->
                <svg class="chevron-up hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
              </button>
            </div>

            <p class="text-sm sm:text-base text-zinc-700 dark:text-zinc-300 mb-3 font-normal">
              {edu.institution}
            </p>

            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {edu.description}
            </p>
          </div>

          <!-- Expanded Details / Highlights (Hidden by default) -->
          {edu.highlights && (
            <div class="edu-details hidden mt-4 pt-4 border-t border-black/10 dark:border-white/10 animate-in fade-in duration-200">
              <h5 class="text-xs font-mono uppercase tracking-wider text-black dark:text-white mb-2">
                Academic Highlights & Projects
              </h5>
              <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300 mb-3">
                {edu.highlights.map((h) => (
                  <li class="flex items-start gap-2">
                    <span class="text-black dark:text-white font-mono">›</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              {edu.gpa && (
                <div class="inline-block px-2.5 py-1 bg-gray-50 dark:bg-[#000000] border border-black/15 dark:border-white/15 text-xs font-mono text-zinc-700 dark:text-zinc-300">
                  Score / GPA: <span class="text-black dark:text-white font-medium">{edu.gpa}</span>
                </div>
              )}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  let expandedEduId: string | null = null;
  const eduCards = document.querySelectorAll('.edu-card');

  eduCards.forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-id');
      const details = card.querySelector('.edu-details');
      const chevronDown = card.querySelector('.chevron-down');
      const chevronUp = card.querySelector('.chevron-up');
      
      if (expandedEduId === id) {
        expandedEduId = null; // collapse
        if (details) details.classList.add('hidden');
        if (chevronDown) chevronDown.classList.remove('hidden');
        if (chevronUp) chevronUp.classList.add('hidden');
      } else {
        // Collapse all others
        eduCards.forEach(c => {
          const d = c.querySelector('.edu-details');
          const cd = c.querySelector('.chevron-down');
          const cu = c.querySelector('.chevron-up');
          if (d) d.classList.add('hidden');
          if (cd) cd.classList.remove('hidden');
          if (cu) cu.classList.add('hidden');
        });
        
        expandedEduId = id; // expand new one
        if (details) details.classList.remove('hidden');
        if (chevronDown) chevronDown.classList.add('hidden');
        if (chevronUp) chevronUp.classList.remove('hidden');
      }
    });
  });
</script>
