---
import { SKILL_CATEGORIES } from '../data/portfolioData';

const getIconHtml = (iconName: string) => {
  switch (iconName) {
    case 'terminal':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-black dark:text-white"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>`;
    case 'dns':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-zinc-600 dark:text-zinc-300"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>`;
    case 'architecture':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-zinc-600 dark:text-zinc-400"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>`;
    case 'wrench':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-zinc-600 dark:text-zinc-300"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`;
    case 'palette':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-zinc-600 dark:text-zinc-300"><circle cx="13.5" cy="6.5" r=".5"></circle><circle cx="17.5" cy="10.5" r=".5"></circle><circle cx="8.5" cy="7.5" r=".5"></circle><circle cx="6.5" cy="12.5" r=".5"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path></svg>`;
    default:
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-black dark:text-white"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 17 22 12"></polyline></svg>`;
  }
};
---

<section id="skills" class="w-full max-w-5xl mx-auto mb-24 sm:mb-32 pt-8 px-4 sm:px-6">
  <div class="space-y-6">
    <!-- Section Header -->
    <div class="border-b border-black/10 dark:border-white/10 pb-4 mb-8 flex justify-between items-end">
      <h3 class="text-2xl sm:text-3xl text-black dark:text-white font-semibold tracking-tight">
        Skills and Technologies
      </h3>
      <span class="font-mono text-xs sm:text-sm text-zinc-500 font-medium">/01</span>
    </div>

    <!-- Skills Grid - Professional Monochrome -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SKILL_CATEGORIES.map((category) => (
        <div
          id={`skill-card-${category.id}`}
          class="skill-card border border-black/10 dark:border-white/10 bg-white dark:bg-[#0a0a0a] p-6 interactive-card transition-all cursor-pointer group"
          data-id={category.id}
        >
          <!-- Card Title & Icon -->
          <div class="text-black dark:text-white mb-3 font-medium flex items-center justify-between">
            <div class="flex items-center gap-2.5 text-base">
              <span set:html={getIconHtml(category.icon)} />
              <span class="group-hover:text-black dark:group-hover:text-white transition-colors">{category.title}</span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-6 min-h-[48px] sm:min-h-[58px] leading-relaxed">
            {category.description}
          </p>

          <!-- Tech List -->
          <div class="flex flex-col gap-2.5 border-t border-black/10 dark:border-white/10 pt-4">
            {category.technologies.map((tech) => (
              <div class="flex items-center justify-between group/item py-0.5">
                <span class="text-zinc-700 dark:text-zinc-300 font-mono text-xs sm:text-[12px] group-hover/item:text-black dark:group-hover/item:text-white transition-colors">
                  {tech.name}
                </span>
                <span class="text-zinc-500 text-[10px] font-mono opacity-0 group-hover:opacity-100 transition-opacity">
                  {tech.experience}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  let selectedCategory: string | null = null;
  const cards = document.querySelectorAll('.skill-card');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-id');
      if (selectedCategory === id) {
        selectedCategory = null;
      } else {
        selectedCategory = id;
      }
      
      cards.forEach(c => {
        if (c.getAttribute('data-id') === selectedCategory) {
          c.classList.add('dark:border-white/50', 'border-black/50', 'dark:shadow-[0_0_30px_rgba(255,255,255,0.06)]', 'shadow-[0_0_30px_rgba(0,0,0,0.06)]', 'dark:bg-[#121212]', 'bg-gray-50');
        } else {
          c.classList.remove('dark:border-white/50', 'border-black/50', 'dark:shadow-[0_0_30px_rgba(255,255,255,0.06)]', 'shadow-[0_0_30px_rgba(0,0,0,0.06)]', 'dark:bg-[#121212]', 'bg-gray-50');
        }
      });
    });
  });
</script>
