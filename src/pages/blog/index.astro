---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("my-blog", ({ data }) => !data.draft);

// Sort by date descending
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) => {
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};
---

<Layout
    title="Blog | Eldho Eapen"
    description="My thoughts, tutorials, and notes"
>
    <div class="pt-32">
        <div class="mb-12">
            <a
                href="/"
                class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 font-medium transition-colors mb-6 group"
            >
                <i
                    class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"
                ></i>
                Back to Home
            </a>
            <h1
                class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4"
            >
                Blog
            </h1>
            <p class="text-gray-600 dark:text-gray-400 text-lg">
                My thoughts, tutorials, and notes.
            </p>
        </div>

        {
            posts.length === 0 ? (
                <div class="text-center py-16">
                    <i class="fa-solid fa-pen-nib text-4xl text-gray-300 dark:text-gray-700 mb-4" />
                    <p class="text-gray-500 dark:text-gray-400">
                        No posts yet. Check back soon!
                    </p>
                </div>
            ) : (
                <div class="space-y-6">
                    {posts.map((post) => (
                        <a href={`/blog/${post.id}`} class="block group">
                            <article class="p-6 rounded-2xl bg-white/50 dark:bg-dark-surface/50 border border-gray-200 dark:border-dark-border hover:border-primary-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-primary-500/5 hover:-translate-y-1">
                                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-3">
                                    <h2 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                                        {post.data.title}
                                    </h2>
                                    <time class="text-sm text-gray-500 dark:text-gray-400 shrink-0">
                                        {formatDate(post.data.date)}
                                    </time>
                                </div>
                                <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
                                    {post.data.description}
                                </p>
                                {post.data.tags &&
                                    post.data.tags.length > 0 && (
                                        <div class="flex flex-wrap gap-2">
                                            {post.data.tags.map((tag) => (
                                                <span class="px-3 py-1 text-xs font-medium rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300">
                                                    {tag}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                            </article>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</Layout>
